# Copy this file to ~/.skydodger/keystore.properties and fill in your own values.
# The real file must never be committed: it holds the passwords for the upload key.
#
# Create the keystore once with:
#   keytool -genkeypair -v -keystore skydodger-release.jks -alias skydodger \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# Without this file the release build is produced unsigned and the project still builds.

storeFile=/absolute/path/to/skydodger-release.jks
storePassword=change-me
keyAlias=skydodger
keyPassword=change-me
